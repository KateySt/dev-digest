{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-pr-self-review.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git blame*)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch -v*)",
      "Bash(git branch -a*)",
      "Bash(git fetch*)",
      "Bash(git remote*)",
      "Bash(git tag)",
      "Bash(git tag -l*)",
      "Bash(git describe*)",
      "Bash(git shortlog*)",
      "Bash(git reflog show*)",
      "Bash(git reflog list*)",
      "Bash(git stash list*)",
      "Bash(git stash show*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git ls-remote*)",
      "Bash(git cat-file*)",
      "Bash(git rev-parse*)",
      "Bash(git rev-list*)",
      "Bash(git diff-tree*)",
      "Bash(git whatchanged*)",
      "Bash(git grep*)",
      "Bash(git help*)",
      "Bash(git --version*)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git merge*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch -m*)",
      "Bash(git clean*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git tag -d*)",
      "Bash(git tag -a*)",
      "Bash(git tag -f*)",
      "Bash(git stash push*)",
      "Bash(git stash pop*)",
      "Bash(git stash apply*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git stash save*)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git restore*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(git am*)",
      "Bash(git apply*)",
      "Bash(git submodule*)",
      "Bash(git worktree add*)",
      "Bash(git worktree remove*)",
      "Bash(git worktree prune*)",
      "Bash(git filter-branch*)",
      "Bash(git gc*)",
      "Bash(git prune*)",
      "Bash(git config*)",
      "Bash(git init*)",
      "Bash(git update-ref*)",
      "Bash(git symbolic-ref*)",
      "Bash(git replace*)",
      "Bash(git notes*)",
      "Bash(git fast-import*)",
      "Bash(git -c *)"
    ]
  }
}
