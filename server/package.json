{
  "name": "@devdigest/api",
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "dev:desktop": "tsx src/desktop.ts",
    "bundle:desktop": "node scripts/bundle.mjs",
    "mcp:watch": "tsx watch src/mcp.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@ast-grep/napi": "0.50.0",
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/ripgrep": "^1.15.9",
    "dependency-cruiser": "^18.6.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-sse-v2": "^4.2.1",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-metrics": "^2.4.0",
    "js-tiktoken": "^1.0.21",
    "octokit": "^5.0.5",
    "openai": "^7.32.0",
    "p-queue": "^10.0.0",
    "postgres": "^3.4.5",
    "simple-git": "^4.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
