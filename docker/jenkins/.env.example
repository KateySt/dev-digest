# Copy to docker/jenkins/.env (git-ignored) and fill in. Read by JCasC on Jenkins start.
JENKINS_PORT=8090
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
# OpenRouter key the DevDigest runner calls the model with.
OPENROUTER_API_KEY=
# GitHub user + token (repo scope) for the test repository.
GITHUB_USER=
GITHUB_TOKEN=
